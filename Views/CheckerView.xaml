<UserControl x:Class="PassMasterSuite.Views.CheckerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PassMasterSuite.Controls"
             TextElement.Foreground="{StaticResource Brush.TextPrimary}"
             FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="44,40,44,40" MaxWidth="820" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Checker" Style="{StaticResource Text.Display}"/>
                <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,8,0,0"
                           Text="Type a password to see its strength, entropy, weaknesses, and how long it would take to crack."/>
            </StackPanel>

            <!-- Analysis card -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="Password" Style="{StaticResource Text.Small}"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <PasswordBox x:Name="PwSecure" Style="{StaticResource Input.PasswordBox}"
                                         PasswordChanged="Secure_Changed"/>
                            <TextBox x:Name="PwPlain" Style="{StaticResource Input.TextBox.Mono}"
                                     Visibility="Collapsed" TextChanged="Plain_Changed"/>
                        </Grid>
                        <Button x:Name="BtnReveal" Grid.Column="1" Style="{StaticResource IconButton}" Margin="10,0,0,0"
                                Click="Reveal_Click">
                            <Button.ToolTip>Show or hide the password</Button.ToolTip>
                        </Button>
                    </Grid>

                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,20,0,20"/>

                    <!-- Strength meter -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Strength" Style="{StaticResource Text.Body}"/>
                        <TextBlock x:Name="EntropyNote" Grid.Column="1" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                    </Grid>
                    <controls:StrengthMeter x:Name="Meter" Margin="0,12,0,0"/>

                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,20,0,20"/>

                    <!-- Criteria -->
                    <TextBlock Text="What it contains" Style="{StaticResource Text.Body}"/>
                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,22,10">
                            <TextBlock x:Name="IcoLen" Style="{StaticResource Icon}" FontSize="15"/>
                            <TextBlock Text="12+ characters" Style="{StaticResource Text.Small}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,22,10">
                            <TextBlock x:Name="IcoLower" Style="{StaticResource Icon}" FontSize="15"/>
                            <TextBlock Text="Lowercase" Style="{StaticResource Text.Small}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,22,10">
                            <TextBlock x:Name="IcoUpper" Style="{StaticResource Icon}" FontSize="15"/>
                            <TextBlock Text="Uppercase" Style="{StaticResource Text.Small}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,22,10">
                            <TextBlock x:Name="IcoDigit" Style="{StaticResource Icon}" FontSize="15"/>
                            <TextBlock Text="Digit" Style="{StaticResource Text.Small}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,22,10">
                            <TextBlock x:Name="IcoSymbol" Style="{StaticResource Icon}" FontSize="15"/>
                            <TextBlock Text="Symbol" Style="{StaticResource Text.Small}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Weaknesses -->
                    <StackPanel x:Name="WeakPanel" Margin="0,8,0,0" Visibility="Collapsed">
                        <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,12,0,16"/>
                        <TextBlock Text="Weaknesses" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Danger}"/>
                        <StackPanel x:Name="WeakList" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Suggestions -->
                    <StackPanel x:Name="TipPanel" Margin="0,8,0,0" Visibility="Collapsed">
                        <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,12,0,16"/>
                        <TextBlock Text="Suggestions" Style="{StaticResource Text.Body}"/>
                        <StackPanel x:Name="TipList" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Time to crack card -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource Glyph.Clock}"
                                   FontSize="16" Foreground="{StaticResource Brush.Accent}"/>
                        <TextBlock Text="Estimated time to crack" Style="{StaticResource Text.H2}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                               Text="The same password takes very different times depending on the attacker's speed."/>
                    <StackPanel x:Name="CrackRows" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
