<Window x:Class="PassMasterSuite.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassMasterSuite" Height="700" Width="1080"
        MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        TextElement.FontFamily="Segoe UI"
        TextElement.Foreground="{StaticResource Brush.TextPrimary}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nav rail — identical chrome across every view -->
        <Border Grid.Column="0" Width="230" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="22,26,22,18">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource Glyph.Lock}"
                                   FontSize="22" Foreground="{StaticResource Brush.Accent}"/>
                        <TextBlock Text="PassMaster" FontFamily="Segoe UI" FontSize="19" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Password toolkit" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <RadioButton x:Name="NavHome" GroupName="nav" Style="{StaticResource Nav.Item}"
                                 IsChecked="True" Checked="Nav_Checked" Tag="Home">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource Glyph.Home}" Width="22"/>
                            <TextBlock Text="Home" FontFamily="Segoe UI" FontSize="14" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGenerator" GroupName="nav" Style="{StaticResource Nav.Item}"
                                 Checked="Nav_Checked" Tag="Generator">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource Glyph.Generate}" Width="22"/>
                            <TextBlock Text="Generator" FontFamily="Segoe UI" FontSize="14" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavChecker" GroupName="nav" Style="{StaticResource Nav.Item}"
                                 Checked="Nav_Checked" Tag="Checker">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource Glyph.Gauge}" Width="22"/>
                            <TextBlock Text="Checker" FontFamily="Segoe UI" FontSize="14" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavCracker" GroupName="nav" Style="{StaticResource Nav.Item}"
                                 Checked="Nav_Checked" Tag="Cracker">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource Glyph.Speed}" Width="22"/>
                            <TextBlock Text="Cracker" FontFamily="Segoe UI" FontSize="14" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Margin="22,0,22,22">
                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource Glyph.Info}"
                                   FontSize="13" Foreground="{StaticResource Brush.TextMuted}"/>
                        <TextBlock Text="Offline · Educational" Style="{StaticResource Text.Muted}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content host -->
        <ContentControl x:Name="Host" Grid.Column="1"/>
    </Grid>
</Window>
